# ==========================================================
# osint-recon-tool - Variables de entorno opcionales
# Copia este archivo a ".env" y completa solo las llaves que tengas.
# La herramienta funciona sin ninguna llave (modo gratuito).
# ==========================================================

# Have I Been Pwned v3 (https://haveibeenpwned.com/API/Key)
# Habilita la consulta de brechas y pastes asociadas a un correo concreto.
HIBP_API_KEY=

# Numverify / apilayer (https://numverify.com/)
# Enriquece el tipo de línea (móvil / fija / VoIP) y la operadora.
NUMVERIFY_API_KEY=

# Timeout global (segundos) para peticiones HTTP
HTTP_TIMEOUT=10

# Región por defecto para números sin prefijo internacional (ISO 3166-1 alfa-2)
DEFAULT_PHONE_REGION=MX
